<body class="bg-apple-lightgray text-apple-dark">
    <header class="fixed top-0 left-0 right-0 z-50 bg-gradient-to-r from-[#4A90B9] to-[#6CB2D6] text-white p-4 md:p-6 shadow-md rounded-b-3xl">
        <div class="container mx-auto">
            <div class="flex flex-col md:flex-row justify-between items-center">
                <div class="text-center md:text-left mb-4 md:mb-0">
                    <h1 class="text-3xl md:text-4xl font-bold text-shadow">Baseball Bros: Browser Baseball Game 2025</h1>
                </div>
                <nav class="md:ml-8">
                    <ul class="flex space-x-6">
                        <li><a href="#game" class="text-lg hover:text-apple-yellow transition-colors text-shadow font-medium">Play Now</a></li>
                        <li><a href="#about" class="text-lg hover:text-apple-yellow transition-colors text-shadow font-medium">About</a></li>
                        <li><a href="#how-to-play" class="text-lg hover:text-apple-yellow transition-colors text-shadow font-medium">How to Play</a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </header>

    <!-- &#x5934;&#x90e8;&#x5360;&#x4f4d; -->
    <div class="h-16 md:h-24"></div>

    <main class="container mx-auto p-4 md:p-6">
        <section id="game" class="my-8">
            <h2 class="text-2xl md:text-3xl font-bold mb-4" style="color: #4A90B9">Play Baseball Bros Online</h2>
            <div class="bg-white rounded-lg shadow-lg overflow-hidden">
                <div itemscope="" itemtype="https://schema.org/VideoGame">
                    <meta itemprop="playMode" content="Browser">
                    <meta itemprop="device" content="PC, Mobile, Tablet">
                    <div class="relative w-full" style="padding-top: 56.25%">
                        <!-- &#x6dfb;&#x52a0;&#x9aa8;&#x67b6;&#x5c4f; -->
                        <div class="skeleton absolute top-0 left-0 w-full h-full"></div>
                        <iframe data-src="https://baseballbrosio.io/game/baseball-bros/" class="absolute top-0 left-0 w-full h-full opacity-0 transition-opacity duration-300" loading="lazy" decoding="async" title="Play Baseball Bros Unblocked" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen="" onload="this.classList.add('opacity-100'); this.previousElementSibling.style.display='none';">
                        </iframe>
                    </div>
                </div>
            </div>
        </section>

        <section id="about" class="my-12">
            <h2 class="text-2xl md:text-3xl font-bold mb-4" style="color: #4A90B9">Baseball Bros Game Overview</h2>
            <div class="bg-white rounded-lg shadow-lg p-6">
                <p class="text-lg md:text-xl mb-4">Baseball Bros is a fast-paced multiplayer baseball IO game where you compete against players worldwide. With simple controls and addictive gameplay, it's perfect for quick sessions at school or work in 2025.</p>
            </div>
        </section>

        <section id="how-to-play" class="my-12">
            <h2 class="text-2xl md:text-3xl font-bold mb-4" style="color: #4A90B9">Baseball Bros Controls &amp; Tips</h2>
            <div class="bg-white rounded-lg shadow-lg p-6">
                <h3 class="text-xl font-semibold text-apple-dark mb-4">Baseball Bros Keyboard Controls (2025)</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <div class="p-4 bg-apple-lightgray rounded-lg">
                        <h3 class="text-xl font-semibold text-apple-blue mb-2">Movement</h3>
                        <p>Use Arrow Keys to move your player</p>
                    </div>
                    <div class="p-4 bg-apple-lightgray rounded-lg">
                        <h3 class="text-xl font-semibold text-apple-green mb-2">Batting</h3>
                        <p>Press Spacebar to swing the bat</p>
                    </div>
                    <div class="p-4 bg-apple-lightgray rounded-lg">
                        <h3 class="text-xl font-semibold text-apple-orange mb-2">Pitching</h3>
                        <p>Use Mouse to aim when pitching</p>
                    </div>
                    <div class="p-4 bg-apple-lightgray rounded-lg">
                        <h3 class="text-xl font-semibold text-apple-purple mb-2">Pause</h3>
                        <p>Press Escape to pause the game</p>
                    </div>
                </div>
                <div class="mt-8 bg-apple-lightgray rounded-lg p-4">
                    <h3 class="text-xl font-semibold text-apple-blue mb-2">Batting Like a Pro</h3>
                    <p>Want to <strong>hit more home runs in Baseball Bros</strong>? Time your swing when the ball crosses the plate's center.</p>
                </div>
                <p class="text-lg text-apple-blue mt-6 italic">Pro Tip: For advanced moves, try combining Spacebar + Arrow Keys for power hits!</p>
            </div>
        </section>

        <section id="why-play" class="my-12">
            <h2 class="text-2xl md:text-3xl font-bold mb-4" style="color: #4A90B9">Why Play Baseball Bros Online?</h2>
            <div class="bg-white rounded-lg shadow-lg p-6">
                <ul class="space-y-4 text-lg">
                    <li class="flex items-start">
                        <span class="mr-3">&#x1f3ae;</span>
                        <span><strong>Instant Browser Play</strong> &#x2013; No downloads or installations</span>
                    </li>
                    <li class="flex items-start">
                        <span class="mr-3">&#x26a1;</span>
                        <span><strong>Optimized for All Devices</strong> &#x2013; Runs smoothly on Chromebooks, PCs &amp; tablets</span>
                    </li>
                    <li class="flex items-start">
                        <span class="mr-3">&#x1f504;</span>
                        <span><strong>Always Updated</strong> &#x2013; Latest 2025 gameplay improvements</span>
                    </li>
                    <li class="flex items-start">
                        <span class="mr-3">&#x1f310;</span>
                        <span><strong>No Plugins Needed</strong> &#x2013; Works without Flash or Java</span>
                    </li>
                </ul>
                <p class="text-gray-600 italic mt-6 text-sm">Note: Please comply with your local network policies when playing.</p>
            </div>
        </section>

        <section id="school-guide" class="my-12">
            <h2 class="text-2xl md:text-3xl font-bold mb-4" style="color: #4A90B9">Baseball Bros on School Chromebooks</h2>
            <div class="bg-white rounded-lg shadow-lg p-6">
                <h3 class="text-xl font-semibold text-apple-dark mb-4">For the best experience:</h3>
                <ul class="space-y-4 text-lg">
                    <li class="flex items-start">
                        <span class="mr-3">&#x1f4da;</span>
                        <span><strong>Use during breaks</strong> &#x2013; Enjoy the game between classes</span>
                    </li>
                    <li class="flex items-start">
                        <span class="mr-3">&#x1f310;</span>
                        <span><strong>Connect to personal hotspots</strong> &#x2013; If school Wi-Fi restricts access</span>
                    </li>
                    <li class="flex items-start">
                        <span class="mr-3">&#x1f5a5;&#xfe0f;</span>
                        <span><strong>Try alternative browsers</strong> &#x2013; Like Firefox Portable (requires admin permission)</span>
                    </li>
                </ul>
                <p class="text-gray-600 italic mt-6 text-sm">We respect educational institutions' network policies. Contact your IT department for access requests.</p>
            </div>
        </section>

        <section id="strategies" class="my-12">
            <h2 class="text-2xl md:text-3xl font-bold mb-4" style="color: #4A90B9">Best Baseball Bros Strategies</h2>
            <div class="bg-white rounded-lg shadow-lg p-6">
                <div class="space-y-4">
                    <div class="bg-apple-lightgray rounded-lg p-4">
                        <h3 class="text-xl font-semibold text-apple-blue mb-2">Hitting Tips</h3>
                        <p class="text-lg">Want to hit more home runs? Time your swing when the ball is inside the strike zone!</p>
                    </div>
                    <div class="bg-apple-lightgray rounded-lg p-4">
                        <h3 class="text-xl font-semibold text-apple-green mb-2">2025 Pitching Meta</h3>
                        <p>Master the new <strong>curveball technique</strong> added in the 2025 update.</p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer class="bg-gradient-to-r from-[#4A90B9] to-[#6CB2D6] text-white p-6 rounded-t-3xl">
        <div class="container mx-auto text-center">
            <p class="text-shadow">&#xa9; 2025 Baseball Bros. All rights reserved.</p>
